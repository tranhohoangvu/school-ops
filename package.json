{
  "name": "school-ops-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=school-ops-frontend",
    "dev:frontend": "npm run dev --workspace=school-ops-frontend",
    "dev:backend": "npm run dev --workspace=school-ops-backend",
    "build": "npm run build --workspace=school-ops-frontend && npm run build --workspace=school-ops-backend",
    "build:frontend": "npm run build --workspace=school-ops-frontend",
    "build:backend": "npm run build --workspace=school-ops-backend",
    "test": "npm run test --workspace=school-ops-frontend"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0"
  }
}
